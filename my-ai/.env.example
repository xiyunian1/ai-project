JWT_SECRET=replace-with-at-least-32-bytes-secret
JWT_EXPIRATION_MS=86400000
DIFY_API_KEY=your-dify-api-key
# Must be the API base, not the browser chat URL like /chat/xxxx
DIFY_BASE_URL=http://localhost:8080/v1
DIFY_MOCK_ENABLED=false
DIFY_REQUEST_TIMEOUT_SECONDS=20
DIFY_MOCK_DELAY_MS=500
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DB_URL=jdbc:jtds:sqlserver://localhost:1433/myai
DB_DRIVER=net.sourceforge.jtds.jdbc.Driver
DB_DIALECT=org.hibernate.community.dialect.SQLServerLegacyDialect
DB_USERNAME=myai_user
DB_PASSWORD=change-me
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,null
NL2SQL_ENABLED=true
NL2SQL_PROVIDER=dify
NL2SQL_MAX_ROWS=200
NL2SQL_ALLOWED_TABLES=dbo.inout,aisql.dbo.inout,inout
