JWT_SECRET=replace-with-at-least-32-bytes-secret
JWT_EXPIRATION_MS=86400000
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_MOCK_ENABLED=false
LLM_REQUEST_TIMEOUT_SECONDS=20
LLM_MOCK_DELAY_MS=500
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DB_URL=jdbc:jtds:sqlserver://localhost:1433/myai
DB_DRIVER=net.sourceforge.jtds.jdbc.Driver
DB_DIALECT=org.hibernate.community.dialect.SQLServerLegacyDialect
DB_USERNAME=myai_user
DB_PASSWORD=replace-with-your-database-password
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOW_NULL_ORIGIN=false
CODEX_BINARY=codex.cmd
CODEX_MODEL=gpt-5-codex
CODEX_TIMEOUT_SECONDS=600
CODEX_RAW_FILE_ENABLED=false
ANALYSIS_CUSTOM_DB_ENABLED=false
NL2SQL_ENABLED=true
NL2SQL_PROVIDER=openai-compatible
NL2SQL_MAX_ROWS=200
NL2SQL_ALLOWED_TABLES=dbo.inout,aisql.dbo.inout,inout
ANALYSIS_AGENT_MODE=tools
ANALYSIS_AGENT_MAX_TOOL_TURNS=8
RAG_ENABLED=true
RAG_MODE=hybrid_rerank
RAG_DB_URL=jdbc:postgresql://localhost:5432/wms_rag
RAG_DB_USERNAME=wms_rag
RAG_DB_PASSWORD=replace-with-pgvector-password
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.siliconflow.cn
EMBEDDING_MODEL=BAAI/bge-m3
RERANK_MODEL=BAAI/bge-reranker-v2-m3
